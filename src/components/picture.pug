mixin picture(name, ext, width, height, alt = '', isLazy = true)
  - const basePath = `/src/assets/images/${name}`;
  picture
    source(
      type="image/webp"
      srcset=`${basePath}.webp 1x, ${basePath}@2x.webp 2x`
    )
    img(
      src=`${basePath}.${ext}`
      srcset=`${basePath}@2x.${ext} 2x`
      width=width
      height=height
      alt=alt
      loading=isLazy ? 'lazy' : false
    )&attributes(attributes)


